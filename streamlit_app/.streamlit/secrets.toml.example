# Copia este archivo a .streamlit/secrets.toml y pega tus credenciales reales.
# Son las MISMAS que ya usa la app web — están en el .env.local del proyecto
# principal (VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY). Es la clave publica
# "anon", de solo lectura por las politicas RLS de Supabase — segura de usar aqui.
#
# NUNCA pongas aqui la SUPABASE_SERVICE_ROLE_KEY (esa si tiene permisos de
# escritura y debe quedarse solo en el backend de Vercel).

SUPABASE_URL = "https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY = "tu-clave-publica-anon"
