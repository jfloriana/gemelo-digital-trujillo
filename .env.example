# ─────────────────────────────────────────────────────────
#  Gemelo Digital Trujillo — Variables de Entorno
#  Copia este archivo a .env.local y completa tus claves
# ─────────────────────────────────────────────────────────

# GEMINI_API_KEY — Requerida para chatbot IA y funciones generativas
# Consíguela gratis en: https://aistudio.google.com/app/apikey
# En Vite (browser) debe exponerse como VITE_GEMINI_API_KEY
GEMINI_API_KEY="tu_gemini_api_key_aqui"
VITE_GEMINI_API_KEY="tu_gemini_api_key_aqui"

# SUPABASE — Requerido para persistencia (zonas, sensores, lecturas, simulaciones, auth)
# Crea proyecto en https://supabase.com/dashboard y copia URL + anon key (Project Settings > API)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_anon_key_aqui"
# Solo para seed local vía service_role (NUNCA exponer en Vercel browser)
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"

# APP_URL — URL pública donde se sirve la app
# Local: http://localhost:3000
# Producción (Vercel): https://tu-app.vercel.app (Vercel la inyecta automáticamente)
APP_URL="http://localhost:3000"
